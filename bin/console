#!/usr/bin/env php
<?php

use Symfony\Bundle\FrameworkBundle\Console\Application;
use Zenstruck\Foundry\Tests\Fixture\TestKernel;

require_once __DIR__ . '/../tests/bootstrap.php';
require_once __DIR__ . '/../bin/tools/behat/vendor/autoload.php';

foreach ($argv ?? [] as $i => $arg) {
    if (($arg === '--env' || $arg === '-e') && isset($argv[$i + 1])) {
        $_ENV['APP_ENV'] = $argv[$i + 1];
        break;
    }
}

$application = new Application(new \Zenstruck\Foundry\Tests\Fixture\Behat\BehatTestKernel($_ENV['APP_ENV'], true));

$application->run();
